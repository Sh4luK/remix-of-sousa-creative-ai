# =====================================================================
# PRODUÇÃO — referência das variáveis do serviço API no Railway.
# NÃO é lido em prod: no Railway estas vars ficam no dashboard do serviço
# (Variables). Este arquivo só documenta o conjunto obrigatório.
# Local/dev continua usando backend/.env (Supabase dev). Ver DEPLOY.md.
# =====================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=GERAR-CHAVE-ALEATORIA-LONGA-E-UNICA-PARA-PROD
DEBUG=False
# Domínio(s) do serviço API (Railway) + domínio custom da API, se houver.
ALLOWED_HOSTS=seu-servico.up.railway.app,api.seudominio.com

# --- Banco: Supabase de PRODUÇÃO (projeto NOVO, separado do dev) ---
# Session Pooler, porta 5432, IPv4. NUNCA o mesmo do backend/.env local.
DATABASE_URL=postgresql://postgres.[ref-prod]:[senha]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# --- CORS/CSRF: origem do frontend (Cloudflare Pages) ---
CORS_ALLOWED_ORIGINS=https://app.seudominio.com
CSRF_TRUSTED_ORIGINS=https://app.seudominio.com,https://api.seudominio.com

# --- HTTPS (Railway termina TLS na frente) ---
SECURE_SSL_REDIRECT=True
NUM_PROXIES=1

# --- Stability AI (chave REAL de prod) ---
STABILITY_KEY=sk-REAL_PROD_KEY
STABILITY_MODEL=core
STABILITY_SD3_MODEL=sd3.5-large

# --- Turnstile (secret REAL; obrigatório com DEBUG=False, fail-closed) ---
TURNSTILE_SECRET_KEY=0x_REAL_PROD_SECRET

# --- Redis (Railway injeta a URL do plugin Redis) ---
REDIS_URL=${{Redis.REDIS_URL}}

# --- Rate limit auth (opcional; defaults 10/min e 5/min) ---
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=5/min

# --- Sentry (opcional) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
