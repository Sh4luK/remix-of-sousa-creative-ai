# Copie para backend/.env e preencha. NUNCA commite o .env real (gitignored).

# --- Django ---
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Banco: Supabase Session Pooler (IPv4, porta 5432). Ver gotcha G1. ---
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# --- Stability AI ---
STABILITY_KEY=sk-CHANGE_ME
STABILITY_MODEL=core
STABILITY_SD3_MODEL=sd3.5-large

# --- Cloudflare Turnstile (validação do captcha no registro) ---
TURNSTILE_SECRET_KEY=0x_CHANGE_ME

# --- Produção (usados por config.settings.prod) ---
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=True

# --- Sentry (opcional; vazio = desligado) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
