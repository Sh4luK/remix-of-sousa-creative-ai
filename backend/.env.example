# Copie para backend/.env e preencha. NUNCA commite o .env real (gitignored).

# --- Django ---
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Banco: Supabase Session Pooler (IPv4, porta 5432). Ver gotcha G1. ---
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# --- Stability AI ---
STABILITY_KEY=sk-CHANGE_ME
STABILITY_MODEL=core
STABILITY_SD3_MODEL=sd3.5-large

# --- Cloudflare Turnstile (validação do captcha no registro) ---
# Em produção (DEBUG=False) é OBRIGATÓRIO: sem secret válido, o registro é bloqueado (fail-closed).
TURNSTILE_SECRET_KEY=0x_CHANGE_ME

# --- Rate limit dos endpoints de auth (por IP). Formato DRF: "N/min", "N/hour". ---
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=5/min

# --- Redis: cache p/ rate limit GLOBAL entre workers. Vazio = LocMem (por processo). ---
# No docker-compose já é injetado como redis://redis:6379/0. Deixe comentado no .env local.
# REDIS_URL=redis://redis:6379/0

# --- Nº de proxies confiáveis à frente (para o throttle pegar o IP real do cliente). ---
# 1 = só o nginx. Aumente se houver CDN/load balancer adicional. Vazio em dev.
# NUM_PROXIES=1

# --- Produção (usados por config.settings.prod) ---
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=True

# --- Sentry (opcional; vazio = desligado) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0
